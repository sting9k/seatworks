{
  "name": "seatworks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p editor/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test --experimental-strip-types --no-warnings=ExperimentalWarning --import ./test/setup.ts \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && prettier --check . && npm test",
    "template": "node --experimental-strip-types --no-warnings=ExperimentalWarning bin/template.ts",
    "gallery": "node --experimental-strip-types --no-warnings=ExperimentalWarning bin/gallery.ts editor/public/gallery templates",
    "editor": "npm run gallery && vite editor",
    "editor:build": "npm run gallery && vite build editor"
  },
  "dependencies": {
    "@getpaseo/client": "0.10.1",
    "@getpaseo/protocol": "0.10.1",
    "@modelcontextprotocol/server": "2.2.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/red-hat-display": "5.3.0",
    "@fontsource-variable/red-hat-mono": "5.3.0",
    "@fontsource-variable/red-hat-text": "5.3.0",
    "@getpaseo/plugin": "0.10.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@xyflow/react": "12.12.0",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "markdown-it": "15.0.2",
    "prettier": "3.9.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  }
}
