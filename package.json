{
  "name": "seatworks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test --experimental-strip-types --no-warnings=ExperimentalWarning --import ./test/setup.ts \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && prettier --check . && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@getpaseo/plugin": "0.10.1",
    "@types/node": "22.20.4",
    "@types/react": "19.2.18",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
