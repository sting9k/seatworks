{
  "always": {
    "modeId": "bypassPermissions",
    "options": {
      "extraArgs": { "plugin-dir": "{plugin}/harness/claude" },
      "settings": {
        "permissions": {
          "deny": ["Agent", "Workflow", "AskUserQuestion", "ScheduleWakeup", "Skill", "mcp__paseo", "Bash(paseo *)"]
        }
      }
    }
  },
  "writes": {
    "options": {
      "sandbox": {
        "enabled": true,
        "failIfUnavailable": true,
        "allowUnsandboxedCommands": false
      }
    }
  },
  "reads": {}
}
