{
  "servers": false,
  "always": {
    "modeId": "full"
  },
  "home": {
    "env": "PI_CODING_AGENT_DIR",
    "from": "~/.omp/agent",
    "link": ["agent.db"],
    "files": {
      "mcp.json": {
        "mcpServers": {
          "team": {
            "command": "{node}",
            "args": ["--experimental-strip-types", "--no-warnings", "{plugin}/bin/team.ts", "{socket}"],
            "env": {
              "ELECTRON_RUN_AS_NODE": "1",
              "SEATWORKS_PROJECT": "SEATWORKS_PROJECT",
              "SEATWORKS_ACTOR": "SEATWORKS_ACTOR",
              "SEATWORKS_KEY": "SEATWORKS_KEY"
            }
          }
        }
      },
      "config.yml": {
        "tools": {
          "approval": {
            "task": "deny",
            "eval": "deny"
          }
        },
        "mcp": {
          "startupTimeoutMs": 0
        },
        "disabledProviders": ["claude", "codex", "gemini", "opencode", "cursor"]
      }
    }
  }
}
