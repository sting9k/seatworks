{
  "name": "seatworks-v2-paseo-plugin",
  "private": true,
  "version": "3.0.0-dev.308",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test --test-timeout=120000 --import ./test/setup.ts 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm run lint && prettier --check . && npm test",
    "eval:triggers": "node test/skills/run-triggers.ts",
    "eval:watch": "node test/eval/watch-eval.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@modelcontextprotocol/server": "2.1.0",
    "smol-toml": "^1.8.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@getpaseo/plugin": "0.10.1",
    "@types/node": "^24.13.4",
    "@types/react": "~19.2.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "react": "^19.1.0",
    "react-native": "^0.81.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
